# Keep workspace installs fast and non-interactive.
# audit/fund skip post-install network round-trips; progress=false avoids the
# noisy reify spinner; prefer-offline uses the cache when possible; the finite
# fetch timeout/retries stop a stalled download from hanging setup forever
# (the sharp @img/* native binaries were the culprit for the 2h install).
audit=false
fund=false
progress=false
prefer-offline=true
fetch-timeout=120000
fetch-retries=2
